  "answerText": "{{exact}} ≈ {{mag|fixed2}}",
  "hints": [
    {
      "text": "Picture the vector as the diagonal of a box with sides along x, y and z."
    },
    {
      "text": "Use Pythagoras twice: across the base, then up to the opposite corner.",
      "cue": {
        "cue": "solution-step",
        "args": {
          "step": 0
        }
      }
    },
    {
      "text": "|a| = √(p² + q² + r²) with p = {{p}}, q = {{q}}, r = {{r}}."
    }
  ],
  "feedback": {
    "added-components": {
      "text": "Lengths along perpendicular directions don't add directly. Use Pythagoras: square them, add, then take the square root."
    },
    "forgot-square-root": {
      "text": "That's |a|², the sum of the squares. Take its square root."
    },
    "missed-k-component": {
      "text": "That's the diagonal across the base only. Include the k̂ component to reach the far corner."
    },
    "generic": {
      "text": "Treat the vector as a box diagonal and use Pythagoras in three dimensions."
    }
  },
  "workedSolution": [
    {
      "text": "Across the base: √({{p}}² + {{q}}²) = √{{base}}.",
      "cue": {
        "cue": "solution-step",
        "args": {
          "step": 0
        }
      }
    },
    {
      "text": "Up to the far corner: |a| = √({{base}} + {{r*r}}) = √{{ss}}.",
      "cue": {
        "cue": "solution-step",
        "args": {
          "step": 1
        }
      }
    },
    {
      "text": "|a| = {{exact}} ≈ {{mag|fixed2}}.",
      "cue": {
        "cue": "solution-step",
        "args": {
          "step": 2
        }
      }
    }
  ],
  "flashcards": {
    "added-components": {
      "front": "Is |3î + 4ĵ| equal to 7?",
      "back": "No. It is √(3² + 4²) = 5. Perpendicular components combine by Pythagoras."
    },
    "forgot-square-root": {
      "front": "a₁² + a₂² + a₃² equals what?",
      "back": "|a|². Take the square root for |a|."
    },
    "missed-k-component": {
      "front": "Magnitude of a₁î + a₂ĵ + a₃k̂?",
      "back": "√(a₁² + a₂² + a₃²): all three components."
    },
    "generic": {
      "front": "How do you find a 3-D vector's magnitude?",
      "back": "√(a₁² + a₂² + a₃²): Pythagoras twice."
    }
  },
