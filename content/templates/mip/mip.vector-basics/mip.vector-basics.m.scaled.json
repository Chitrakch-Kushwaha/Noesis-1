    "generic": {
      "text": "|ka| = |k| |a|."
    }
  },
  "workedSolution": [
    {
      "text": "|({{k}})a| = |{{k}}| × {{A}} = {{ans}} units."
    },
    {
      "text": "{{k}} < 0 reverses the arrow (it would point south-west); otherwise the direction is unchanged.",
      "cue": {
        "cue": "add-vector",
        "args": {
