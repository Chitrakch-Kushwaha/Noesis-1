  "workedSolution": [
    {
      "text": "{{a}}x = {{c}} − {{b}} = {{cb}}."
    },
    {
      "text": "x = {{cb}} ÷ {{a}} = {{ans}}.",
      "cue": {
        "cue": "marker",
        "args": {
          "x": "{{ans}}",
