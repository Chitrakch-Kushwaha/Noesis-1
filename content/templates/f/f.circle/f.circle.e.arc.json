  },
  "workedSolution": [
    {
      "text": "θ = {{deg}}° = {{thr}} rad."
    },
    {
      "text": "s = {{r}} × {{thr}} = {{cm}} cm.",
      "cue": {
        "cue": "note",
        "args": {
          "text": "s = rθ"
        }
      }
    }
  ],
  "flashcards": {
