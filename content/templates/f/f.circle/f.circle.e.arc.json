    "How long is the arc that subtends {{deg}}° at the centre?"
  ],
  "input": {
    "label": "Arc length",
    "placeholder": "for example 6.3 cm",
    "keypad": "none"
  },
  "answerText": "{{cm}} cm",
  "hints": [
    {
      "text": "s = rθ, with θ in radians.",
      "cue": {
        "cue": "highlight",
        "args": {
          "ids": [
            "top"
          ]
        }
      }
    },
    {
      "text": "Convert: θ = {{deg}} × π ÷ 180."
    },
    {
      "text": "Multiply by r."
    }
  ],
  "feedback": {
    "arc-degrees": {
      "text": "s = rθ needs θ in radians: {{deg}}° = {{thr}} rad."
    },
