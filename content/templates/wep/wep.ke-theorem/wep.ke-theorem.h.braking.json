  "widget": {
    "type": "motion-track",
    "config": {
      "mode": "1d",
      "lanes": [
        {
          "id": "car",
          "label": "car",
          "x0": 0,
          "v0": "{{v}}",
          "a": "{{-mu*9.8}}"
        }
      ],
      "duration": "{{v/(mu*9.8)}}",
      "hideNumbers": true,
      "stopAtRest": true
