  "consequence": [
    {
      "cue": "ghost-lane",
      "args": {
        "lane": {
          "id": "you",
          "label": "steady at your speed",
          "x0": 0,
          "v0": "$value",
          "a": 0
        }
      }
    },
    {
      "cue": "play"
    }
  ],
  "stem": [
    "A {{m}} kg trolley starts from rest on a smooth floor. A constant {{F}} N horizontal force pushes it {{d}} m.",
    "How fast is it moving then?"
  ],
  "input": {
    "label": "Speed",
    "placeholder": "for example 8 m/s",
    "keypad": "none"
  },
  "answerText": "{{ans}} m/s",
  "hints": [
    {
      "text": "The work done becomes kinetic energy.",
      "cue": {
        "cue": "play"
      }
    },
    {
      "text": "W = F d = ½mv² − 0."
    },
    {
      "text": "Solve for v."
    }
  ],
  "feedback": {
    "work-energy-missing-two": {
      "text": "From Fd = ½mv², v² = 2Fd ÷ m: keep the 2."
    },
    "forgot-root-energy": {
      "text": "That is v², not v. Take the square root."
    },
    "dimension-mismatch": {
      "text": "Check the unit: the answer is a velocity."
    },
    "generic": {
      "text": "F d = ½mv², so v = √(2Fd ÷ m)."
    }
  },
  "workedSolution": [
    {
      "text": "Work done: {{F}} × {{d}} = {{W}} J = ½ × {{m}} × v²."
    },
    {
      "text": "v = √(2 × {{W}} ÷ {{m}}) = {{ans}} m/s.",
      "cue": {
        "cue": "reveal"
      }
    }
  ],
  "flashcards": {
    "work-energy-missing-two": {
      "front": "Speed after work W on a body from rest?",
      "back": "v = √(2W ÷ m)."
    },
    "forgot-root-energy": {
      "front": "From ½mv² = E, v = ?",
      "back": "√(2E ÷ m)."
    },
    "generic": {
      "front": "Speed after work W from rest?",
      "back": "v = √(2W ÷ m)."
    }
  },
