  "stem": [
    "A {{m1}} kg cart moving at {{u}} m/s hits a {{m2}} kg cart at rest, and they stick together.",
    "How much kinetic energy is lost in the collision?"
  ],
  "input": {
    "label": "KE lost",
    "placeholder": "for example 12 J",
    "keypad": "none"
  },
  "answerText": "{{ans}} J",
  "hints": [
    {
      "text": "First find the shared speed from momentum.",
      "cue": {
        "cue": "play"
      }
    },
    {
      "text": "v = m₁u ÷ (m₁ + m₂)."
    },
    {
      "text": "Loss = ½m₁u² − ½(m₁ + m₂)v²."
    }
  ],
  "feedback": {
    "ke-final-for-loss": {
      "text": "That is the kinetic energy left after the collision. The loss is initial KE minus final KE."
    },
    "all-ke-lost": {
      "text": "The carts keep moving after sticking (momentum is conserved), so not all the KE is lost."
    },
    "dimension-mismatch": {
      "text": "Check the unit: the answer is a energy."
    },
    "generic": {
      "text": "KE lost = ½m₁u² − ½(m₁ + m₂)v²."
    }
  },
  "workedSolution": [
    {
      "text": "v = {{m1}} × {{u}} ÷ ({{m1}} + {{m2}}) = {{v}} m/s."
    },
    {
      "text": "KE before {{k1}} J, after {{k2}} J: lost {{ans}} J.",
      "cue": {
        "cue": "ghost-lane",
        "args": {
          "lane": {
            "id": "after",
            "label": "carts together",
            "x0": 0,
            "v0": "{{v}}",
            "a": 0
          }
        }
      }
    }
  ],
