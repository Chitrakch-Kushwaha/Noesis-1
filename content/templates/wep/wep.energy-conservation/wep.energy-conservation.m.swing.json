  "stem": [
    "A pendulum bob on a {{L}} m string is pulled aside until the string makes {{th}}° with the vertical, then released.",
    "How fast is the bob moving at the lowest point? Take g = 9.8 m/s²."
  ],
  "input": {
    "label": "Speed",
    "placeholder": "for example 2.5 m/s",
    "keypad": "none"
  },
  "answerText": "{{ans}} m/s",
  "hints": [
    {
      "text": "How far does the bob drop between release and the lowest point?",
      "cue": {
        "cue": "highlight",
        "args": {
          "ids": [
            "energy"
          ]
        }
      }
    },
    {
      "text": "Drop = L(1 − cos θ)."
    },
    {
      "text": "mg × drop = ½mv²."
    }
  ],
  "feedback": {
    "swing-full-drop": {
      "text": "The bob doesn't fall the whole string length: it drops L(1 − cos θ)."
    },
    "swing-uses-cos": {
      "text": "L cos θ is the height of the support above the bob; the drop is L − L cos θ."
    },
    "dimension-mismatch": {
      "text": "Check the unit: the answer is a velocity."
    },
    "generic": {
      "text": "v = √(2gL(1 − cos θ))."
    }
  },
  "workedSolution": [
    {
      "text": "Drop: {{L}} × (1 − cos {{th}}°) = {{drop}} m."
    },
    {
      "text": "v = √(2 × 9.8 × {{drop}}) = {{ans}} m/s.",
      "cue": {
        "cue": "highlight",
        "args": {
          "ids": [
            "energy"
          ]
        }
      }
    }
  ],
