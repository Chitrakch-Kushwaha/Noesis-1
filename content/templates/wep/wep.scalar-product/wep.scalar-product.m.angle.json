  "input": {
    "label": "Angle (°)",
    "placeholder": "for example 45",
    "keypad": "none"
  },
  "answerText": "{{ans}}",
  "hints": [
    {
      "text": "Find a · b from the components first.",
      "cue": {
        "cue": "components"
      }
    },
    {
      "text": "Then cos θ = (a · b) ÷ (|a||b|)."
    },
    {
      "text": "Finally θ = cos⁻¹(…)."
    }
  ],
  "feedback": {
    "dot-as-angle": {
      "text": "That is the scalar product a · b. Divide it by |a||b| to get cos θ, then take the inverse cosine."
    },
    "generic": {
      "text": "cos θ = a · b ÷ (|a||b|)."
    }
  },
  "workedSolution": [
    {
      "text": "a · b = {{ax}} × {{bx}} + {{ay}} × {{by}} = {{dot}}; |a| = {{ma}}, |b| = {{mb}}."
    },
    {
      "text": "cos θ = {{dot}} ÷ ({{ma}} × {{mb}}) = {{cos}}, so θ = {{ans}}°.",
      "cue": {
        "cue": "project",
        "args": {
          "a": "a",
          "b": "b"
        }
      }
    }
  ],
  "flashcards": {
