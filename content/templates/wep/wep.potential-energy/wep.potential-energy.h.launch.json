  "stem": [
    "A {{m}} kg block is pushed against a spring (k = {{k}} N/m), compressing it by {{xcm}} cm on a smooth floor, and released.",
    "How fast does the block leave the spring?"
  ],
  "input": {
    "label": "Speed",
    "placeholder": "for example 3 m/s",
    "keypad": "none"
  },
  "answerText": "{{ans}} m/s",
  "hints": [
    {
      "text": "The spring's stored energy all becomes kinetic energy.",
      "cue": {
        "cue": "highlight",
        "args": {
          "ids": [
            "energy"
          ]
        }
      }
    },
    {
      "text": "½kx² = ½mv²."
    },
    {
      "text": "v = x √(k ÷ m), x in metres."
    }
  ],
  "feedback": {
    "spring-launch-root": {
      "text": "From ½kx² = ½mv², v² = kx²/m: take the square root."
    },
    "spring-missing-half": {
      "text": "Both energies have a ½: ½kx² = ½mv², so they cancel."
    },
    "dimension-mismatch": {
      "text": "Check the unit: the answer is a velocity."
    },
    "generic": {
      "text": "½kx² = ½mv², so v = x√(k/m)."
    }
  },
  "workedSolution": [
    {
      "text": "Stored energy: ½ × {{k}} × {{x}}² = {{E}} J."
    },
    {
      "text": "½ × {{m}} × v² = {{E}}, so v = {{ans}} m/s.",
      "cue": {
        "cue": "highlight",
        "args": {
          "ids": [
            "energy"
          ]
        }
      }
    }
  ],
  "flashcards": {
