  "stem": [
    "A {{m}} kg mass on a spring with k = {{k}} N/m oscillates horizontally on a smooth surface.",
    "What is its period?"
  ],
  "input": {
    "label": "Period",
    "placeholder": "for example 0.6 s",
    "keypad": "none"
  },
  "answerText": "{{ans}} s",
  "hints": [
    {
      "text": "From F = −kx and F = ma: a = −(k/m)x.",
      "cue": {
        "cue": "play"
      }
    },
    {
      "text": "So ω = √(k ÷ m)."
    },
    {
      "text": "T = 2π ÷ ω."
    }
  ],
  "feedback": {
    "spring-period-inverted": {
      "text": "A heavier mass oscillates more slowly: T = 2π√(m ÷ k)."
    },
    "spring-period-no-2pi": {
      "text": "T = 2π√(m ÷ k): include the 2π."
    },
    "dimension-mismatch": {
      "text": "Check the unit: the answer is a time."
    },
    "generic": {
      "text": "T = 2π√(m ÷ k)."
    }
  },
  "workedSolution": [
    {
      "text": "ω = √({{k}} ÷ {{m}}) = {{w}} rad/s."
    },
    {
      "text": "T = 2π ÷ ω = {{ans}} s.",
      "cue": {
        "cue": "reveal"
      }
    }
  ],
