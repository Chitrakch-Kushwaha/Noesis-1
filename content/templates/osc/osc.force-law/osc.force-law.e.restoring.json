    {
      "cue": "highlight",
      "args": {
        "ids": [
          "spring"
        ]
      }
    }
  ],
  "stem": [
    "A spring with k = {{k}} N/m is stretched {{xcm}} cm from its natural length.",
    "What is the size of the restoring force?"
  ],
  "input": {
    "label": "Force",
    "placeholder": "for example 8 N",
    "keypad": "none"
  },
  "answerText": "{{ans}} N",
  "hints": [
    {
      "text": "The restoring force is proportional to the displacement.",
      "cue": {
        "cue": "highlight",
        "args": {
          "ids": [
            "spring"
          ]
        }
      }
    },
    {
      "text": "F = −kx; its size is kx."
    },
    {
      "text": "x in metres: {{xcm}} cm = {{x}} m."
    }
  ],
  "feedback": {
    "spring-cm-not-converted": {
      "text": "Convert {{xcm}} cm to metres before using F = kx."
    },
    "dimension-mismatch": {
      "text": "Check the unit: the answer is a force."
    },
    "generic": {
      "text": "|F| = kx with x in metres."
    }
  },
  "workedSolution": [
    {
      "text": "x = {{x}} m."
    },
    {
      "text": "|F| = {{k}} × {{x}} = {{ans}} N, back towards equilibrium.",
      "cue": {
        "cue": "highlight",
        "args": {
          "ids": [
            "spring"
          ]
        }
      }
    }
  ],
