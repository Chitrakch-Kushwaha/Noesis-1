  },
  "consequence": [
    {
      "cue": "ghost",
      "args": {
        "key": "k",
        "value": "{{k}}",
        "label": "one spring alone"
      }
    }
  ],
  "stem": [
    "A {{m}} kg block is attached to two identical springs (k = {{k}} N/m each) side by side, both stretched equally when it moves.",
    "What is the period of its oscillation?"
  ],
  "input": {
    "label": "Period",
    "placeholder": "for example 0.4 s",
    "keypad": "none"
  },
  "answerText": "{{ans}} s",
  "hints": [
    {
      "text": "When the block moves x, each spring pulls back kx.",
      "cue": {
        "cue": "ghost",
        "args": {
          "key": "k",
          "value": "{{k}}",
          "label": "one spring alone"
        }
      }
    },
    {
      "text": "Total restoring force 2kx: k_eff = 2k."
    },
    {
      "text": "T = 2π√(m ÷ k_eff)."
    }
  ],
  "feedback": {
    "springs-series-parallel": {
      "text": "Side by side, both springs push back together: k_eff = 2k (end to end would give k/2)."
    },
    "springs-single": {
      "text": "Both springs act on the block, so it is stiffer than one spring alone."
    },
    "dimension-mismatch": {
      "text": "Check the unit: the answer is a time."
    },
    "generic": {
      "text": "Parallel springs: k_eff = k₁ + k₂."
    }
  },
  "workedSolution": [
    {
      "text": "k_eff = 2 × {{k}} = {{keff}} N/m."
    },
    {
      "text": "T = 2π√({{m}} ÷ {{keff}}) = {{ans}} s.",
      "cue": {
        "cue": "reveal"
      }
    }
  ],
  "flashcards": {
    "springs-series-parallel": {
      "front": "Two identical springs side by side (parallel): k_eff?",
      "back": "2k (in series: k/2)."
    },
    "springs-single": {
      "front": "Does a second parallel spring change the period?",
      "back": "Yes: k_eff = 2k, so T falls by √2."
    },
    "generic": {
      "front": "Two identical springs side by side: k_eff?",
      "back": "2k."
    }
  },
