  "stem": [
    "A loudspeaker cone vibrates in SHM at {{f}} Hz with amplitude {{A}} m.",
    "What is its maximum acceleration?"
  ],
  "input": {
    "label": "Maximum acceleration",
    "placeholder": "for example 40 m/s^2",
    "keypad": "none"
  },
  "answerText": "{{ans}} m/s^2",
  "hints": [
    {
      "text": "Where is the acceleration greatest?",
      "cue": {
        "cue": "highlight",
        "args": {
          "ids": [
            "x"
          ]
        }
      }
    },
    {
      "text": "At the ends: a_max = Aω²."
    },
    {
      "text": "ω = 2πf."
    }
  ],
  "feedback": {
    "vmax-amax-confusion": {
      "text": "Aω is the maximum speed. The maximum acceleration is Aω²."
    },
    "shm-forgot-2pi": {
      "text": "ω = 2πf, not f."
    },
    "dimension-mismatch": {
      "text": "Check the unit: the answer is a acceleration."
    },
    "generic": {
      "text": "a_max = A(2πf)²."
    }
  },
  "workedSolution": [
    {
      "text": "ω = 2π × {{f}} = {{w}} rad/s."
    },
    {
      "text": "a_max = {{A}} × {{w}}² = {{ans}} m/s².",
      "cue": {
        "cue": "reveal"
      }
    }
  ],
  "flashcards": {
