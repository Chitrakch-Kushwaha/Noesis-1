  "stem": [
    "A particle in SHM has amplitude {{A}} m and period {{T}} s.",
    "How fast is it moving when it is {{x}} m from the centre?"
  ],
  "input": {
    "label": "Speed",
    "placeholder": "for example 0.3 m/s",
    "keypad": "none"
  },
  "answerText": "{{ans}} m/s",
  "hints": [
    {
      "text": "Use the reference circle: the speed comes from the vertical part of the rotating arm.",
      "cue": {
        "cue": "highlight",
        "args": {
          "ids": [
            "phasor"
          ]
        }
      }
    },
    {
      "text": "v = ω√(A² − x²)."
    },
    {
      "text": "ω = 2π ÷ T."
    }
  ],
  "feedback": {
    "shm-speed-linear": {
      "text": "Speed doesn't fall in proportion to (A − x); use v = ω√(A² − x²)."
    },
    "dimension-mismatch": {
      "text": "Check the unit: the answer is a velocity."
