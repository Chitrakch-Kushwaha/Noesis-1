  "stem": [
    "A mass oscillates in SHM with amplitude {{A}} m and period {{T}} s.",
    "What is its maximum speed?"
  ],
  "input": {
    "label": "Maximum speed",
    "placeholder": "for example 0.6 m/s",
    "keypad": "none"
  },
  "answerText": "{{ans}} m/s",
  "hints": [
    {
      "text": "Where is the speed greatest?",
      "cue": {
        "cue": "highlight",
        "args": {
          "ids": [
            "phasor"
          ]
        }
      }
    },
    {
      "text": "At the centre, with v_max = Aω."
    },
    {
      "text": "ω = 2π ÷ T."
    }
  ],
  "feedback": {
    "vmax-amax-confusion": {
      "text": "Aω² is the maximum acceleration. The maximum speed is Aω."
