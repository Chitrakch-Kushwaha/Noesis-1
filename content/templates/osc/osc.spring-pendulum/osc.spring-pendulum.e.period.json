    {
      "cue": "note",
      "args": {
        "text": "Change the length: does a longer pendulum swing faster or slower?"
      }
    }
  ],
  "stem": [
    "A simple pendulum is {{L}} m long and swings with small amplitude. Take g = 9.8 m/s².",
    "What is its period?"
  ],
  "input": {
    "label": "Period",
    "placeholder": "for example 1.4 s",
    "keypad": "none"
  },
  "answerText": "{{ans}} s",
  "hints": [
    {
      "text": "The period depends on length and g, not on the mass.",
      "cue": {
        "cue": "play"
      }
    },
    {
      "text": "T = 2π√(L ÷ g)."
    },
    {
      "text": "Substitute L = {{L}} m."
    }
  ],
  "feedback": {
    "pendulum-inverted": {
      "text": "A longer pendulum swings more slowly: T = 2π√(L ÷ g)."
    },
    "pendulum-no-root": {
      "text": "T = 2π√(L ÷ g): include the square root."
    },
    "dimension-mismatch": {
      "text": "Check the unit: the answer is a time."
    },
    "generic": {
      "text": "T = 2π√(L ÷ g)."
    }
  },
  "workedSolution": [
    {
      "text": "T = 2π√({{L}} ÷ 9.8)."
    },
    {
      "text": "= {{ans}} s.",
      "cue": {
        "cue": "reveal"
      }
    }
  ],
