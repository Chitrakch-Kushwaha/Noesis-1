  "stem": [
    "A pendulum has a period of {{T}} s on Earth. It is taken to a place where g is {{k}} times smaller.",
    "What is its period there?"
  ],
  "input": {
    "label": "Period",
    "placeholder": "for example 4 s",
    "keypad": "none"
  },
  "answerText": "{{ans}} s",
  "hints": [
    {
      "text": "How does T depend on g?",
      "cue": {
        "cue": "ghost",
        "args": {
          "key": "length",
          "value": "{{9.8*T^2/(4*pi^2)*k}}",
          "label": "same pendulum, weaker g"
        }
      }
    },
    {
      "text": "T ∝ 1 ÷ √g."
    },
    {
      "text": "g ÷ {{k}} multiplies T by √{{k}}."
    }
  ],
  "feedback": {
    "pendulum-g-inverted": {
      "text": "With weaker gravity the restoring force is smaller, so the pendulum swings more slowly."
    },
    "pendulum-g-linear": {
      "text": "T ∝ 1 ÷ √g: g falling by {{k}} raises T by √{{k}}."
    },
    "dimension-mismatch": {
      "text": "Check the unit: the answer is a time."
    },
    "generic": {
      "text": "T' = T √(g ÷ g')."
    }
  },
  "workedSolution": [
    {
      "text": "T ∝ 1 ÷ √g, so T' = {{T}} × √{{k}}."
    },
    {
      "text": "= {{ans}} s.",
