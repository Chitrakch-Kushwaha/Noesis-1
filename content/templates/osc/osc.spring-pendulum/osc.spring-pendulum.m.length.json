  ],
  "stem": [
    "A clockmaker wants a simple pendulum with a period of {{T}} s. Take g = 9.8 m/s².",
    "How long must it be?"
  ],
  "input": {
    "label": "Length",
    "placeholder": "for example 0.5 m",
    "keypad": "none"
  },
  "answerText": "{{ans}} m",
  "hints": [
    {
      "text": "Start from T = 2π√(L ÷ g).",
      "cue": {
        "cue": "play"
      }
    },
    {
      "text": "Square both sides to remove the root."
    },
    {
      "text": "L = gT² ÷ (4π²)."
    }
  ],
  "feedback": {
    "pendulum-length-not-squared": {
      "text": "Square both sides of T = 2π√(L ÷ g): L = gT² ÷ (4π²)."
    },
    "dimension-mismatch": {
      "text": "Check the unit: the answer is a length."
    },
    "generic": {
      "text": "L = gT² ÷ (4π²)."
    }
  },
  "workedSolution": [
    {
      "text": "T² = 4π² L ÷ g."
    },
    {
      "text": "L = 9.8 × {{T}}² ÷ (4π²) = {{ans}} m.",
      "cue": {
        "cue": "reveal"
      }
    }
  ],
