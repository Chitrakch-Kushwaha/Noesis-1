      "kind": "int",
      "min": -4,
      "max": 0
    },
    "y1": {
      "kind": "int",
      "min": -3,
      "max": 3
    },
    "m": {
      "kind": "choice",
      "values": [
        -2,
        -1.5,
        -0.5,
        0.5,
        1.5,
        2
      ]
    },
    "dx": {
      "kind": "choice",
      "values": [
        2,
        4
      ]
    }
  },
  "constraints": [
    "y1 - m*x1 != 0"
  ],
  "solver": "sl.lineThroughPoints",
  "intro": "This question helps us find the best place for you to begin.",
  "answer": {
    "variables": [
      "x",
      "y"
    ],
    "box": {
      "x": [
        -6,
        6
      ],
      "y": [
        -6,
        6
      ]
    }
  },
  "misconceptionRules": [
    {
      "tags": [
        "slope-inverted"
      ],
      "match": {
        "buggySolver": "slopeInverted"
      }
    },
    {
      "tags": [
        "intercept-sign-error"
      ],
      "match": {
        "buggySolver": "interceptSign"
      }
    }
  ],
  "acceptExamples": [
    "{{-m|raw}}*x + y = {{c|raw}}"
  ],
  "widget": {
    "type": "graph-plot",
    "instructions": "Adjust the slope m and the intercept c with the sliders until the line passes through A and B. Its equation updates as you move it.",
    "config": {
      "xRange": [
        -6,
        6
      ],
      "yRange": [
        -6,
        6
      ],
      "functions": [
        {
          "id": "trial",
          "expr": "m*x + c",
          "label": "your line"
        },
        {
          "id": "line",
          "expr": "{{m|raw}}*x + {{c|raw}}",
          "tone": "hidden"
        }
      ],
      "params": {
        "m": {
          "value": 0,
          "min": -3,
          "max": 3,
          "step": 0.5,
          "label": "slope m"
        },
        "c": {
          "value": 0,
          "min": -6,
          "max": 6,
          "step": 0.5,
          "label": "intercept c"
        }
      },
      "points": [
        {
          "id": "A",
          "label": "A",
          "x": "{{x1}}",
          "y": "{{y1}}"
        },
        {
          "id": "B",
          "label": "B",
          "x": "{{x2}}",
          "y": "{{y2}}"
        }
      ],
      "equation": {
        "fn": "trial"
      }
    }
  },
  "stem": [
    "Find the equation of the line through A({{x1}}, {{y1}}) and B({{x2}}, {{y2}}).",
    "Any correct form is accepted, for example y = mx + c or ax + by = d."
  ],
  "input": {
    "label": "Equation",
    "placeholder": "for example y = 2x + 1",
    "keypad": "maths"
  },
  "answerText": "y = {{m}}x {{c|signed}}",
  "hints": [
    {
      "text": "Find the slope first: rise over run between A and B.",
      "cue": {
        "cue": "slope-triangle",
        "args": {
          "fn": "line",
          "x1": "{{x1}}",
          "x2": "{{x2}}"
        }
      }
    },
    {
      "text": "m = ({{y2}} − {{y1}}) ÷ ({{x2}} − {{x1}}). Then use y − y₁ = m(x − x₁)."
    },
    {
      "text": "y − {{y1}} = {{m}}(x − {{x1}}). Rearrange if you like."
    }
  ],
  "feedback": {
    "slope-inverted": {
      "text": "You used run over rise. Slope is the change in y divided by the change in x.",
      "cue": {
        "cue": "slope-triangle",
        "args": {
          "fn": "line",
          "x1": "{{x1}}",
          "x2": "{{x2}}"
        }
      }
    },
    "intercept-sign-error": {
      "text": "Check the sign of the intercept: substitute A into your equation and see whether it holds."
    },
    "generic": {
      "text": "Test your equation with both points: substituting A and B must make it true."
    }
  },
  "workedSolution": [
    {
      "text": "Slope: m = ({{y2}} − {{y1}}) ÷ ({{x2}} − {{x1}}) = {{dy}} ÷ {{dx}} = {{m}}.",
      "cue": [
        {
          "cue": "slope-triangle",
          "args": {
            "fn": "line",
            "x1": "{{x1}}",
            "x2": "{{x2}}"
          }
        },
        {
          "cue": "set-param",
          "args": {
            "name": "m",
            "value": "{{m}}"
          }
        }
      ]
    },
    {
      "text": "Point–slope form: y − {{y1}} = {{m}}(x − {{x1}}).",
      "cue": {
        "cue": "set-param",
        "args": {
          "name": "c",
          "value": "{{c}}"
        }
      }
    },
    {
      "text": "Slope–intercept form: y = {{m}}x {{c|signed}}. The line now passes through both points.",
      "cue": {
        "cue": "highlight",
        "args": {
          "ids": [
            "A",
            "B"
          ]
        }
      }
    }
  ],
  "flashcards": {
    "slope-inverted": {
      "front": "Slope through (x₁, y₁) and (x₂, y₂)?",
      "back": "(y₂ − y₁) / (x₂ − x₁): rise over run."
    },
    "intercept-sign-error": {
      "front": "How do you check a line's equation?",
      "back": "Substitute the given points; each must satisfy it."
    },
    "generic": {
      "front": "Line through two points?",
      "back": "Find m, then y − y₁ = m(x − x₁)."
    }
  },
  "accessibility": {
    "altText": "Coordinate grid with points A({{x1}}, {{y1}}) and B({{x2}}, {{y2}}) and an adjustable line.",
    "nonDragAlternative": "Use the slope and intercept sliders, which work with the keyboard."
  }
}
