        "name": "k",
        "value": "$value"
      }
    }
  ],
  "stem": [
    "The line {{a}}x + {{b}}y + {{c}} = 0 is given.",
    "For what value of k is the line kx + 3y − 6 = 0 parallel to it?"
  ],
  "input": {
    "label": "k",
    "placeholder": "for example 4",
    "keypad": "maths"
  },
  "answerText": "k = {{k}}",
  "hints": [
    {
      "text": "Parallel lines have equal slopes. Find each slope from its general form.",
      "cue": {
        "cue": "highlight",
        "args": {
          "ids": [
            "L1"
          ]
        }
      }
    },
    {
      "text": "For Ax + By + C = 0 the slope is −A ÷ B."
    },
    {
      "text": "Set −k ÷ 3 equal to −a ÷ b and solve for k."
    }
  ],
  "feedback": {
    "general-form-slope-sign": {
      "text": "Check the sign: Ax + By + C = 0 gives y = −(A/B)x − C/B, so the slope is −A/B. Watch your line: it crosses the given one.",
      "cue": {
        "cue": "set-param",
        "args": {
          "name": "k",
          "value": "$value"
        }
      }
    },
    "slope-inverted": {
      "text": "Your ratio is upside down: the slope is −A ÷ B (x-coefficient on top)."
    },
    "generic": {
      "text": "Make the two slopes equal."
    }
  },
  "workedSolution": [
    {
      "text": "Slope of the given line: −{{a}} ÷ {{b}} = {{mText}}.",
      "cue": {
        "cue": "highlight",
        "args": {
          "ids": [
            "L1"
          ]
        }
      }
    },
    {
      "text": "Slope of kx + 3y − 6 = 0: −k ÷ 3. Parallel: −k ÷ 3 = {{mText}}, so k = {{k}}.",
      "cue": {
        "cue": "set-param",
        "args": {
          "name": "k",
          "value": "{{k}}"
        }
      }
    }
  ],
  "flashcards": {
    "general-form-slope-sign": {
      "front": "Slope of Ax + By + C = 0?",
      "back": "−A ÷ B."
    },
    "slope-inverted": {
      "front": "Is the slope of Ax + By + C = 0 equal to −B/A?",
      "back": "No: −A/B."
    },
    "generic": {
      "front": "Parallel lines in general form?",
      "back": "Equal slopes: A₁/B₁ = A₂/B₂."
    }
  },
