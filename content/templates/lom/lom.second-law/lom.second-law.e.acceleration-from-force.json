  "feedback": {
    "force-times-mass": {
      "text": "Multiplying gives units of kg N. A bigger mass should make the acceleration smaller: a = F ÷ m."
    },
    "second-law-inverted": {
      "text": "Your ratio is upside down: a larger force must give a larger acceleration, so a = F ÷ m."
    },
    "dimension-mismatch": {
      "text": "Acceleration is in m/s²."
    },
    "generic": {
      "text": "Use F = m a and rearrange for a."
    }
  },
  "workedSolution": [
    {
      "text": "Newton's second law: F = m a, so a = F ÷ m.",
      "cue": {
        "cue": "predict"
      }
    },
    {
      "text": "a = {{F}} ÷ {{m}} = {{a}} m/s²."
    }
  ],
  "flashcards": {
    "force-times-mass": {
      "front": "Net force F on mass m: acceleration?",
      "back": "a = F ÷ m, not F × m."
