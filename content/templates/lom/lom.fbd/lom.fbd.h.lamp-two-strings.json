  "stem": [
    "A {{m}} kg lamp hangs at rest from two identical strings, each making {{th}}° with the vertical. Take g = 9.8 m/s².",
    "What is the tension in each string?"
  ],
  "input": {
    "label": "Tension",
    "placeholder": "for example 15 N",
    "keypad": "none"
  },
  "answerText": "{{ans}} N",
  "hints": [
    {
      "text": "Draw the three forces: weight and two tensions.",
      "cue": {
        "cue": "highlight",
        "args": {
          "ids": [
            "W",
            "L",
            "R"
          ]
        }
      }
    },
    {
      "text": "Resolve vertically: the vertical parts of the tensions balance the weight."
    },
    {
      "text": "2T cos θ = mg."
    }
  ],
  "feedback": {
    "tension-ignores-angle": {
      "text": "Each string pulls along itself, at {{th}}° to the vertical. Only its vertical part, T cos {{th}}°, holds the lamp up, so T is more than half the weight.",
