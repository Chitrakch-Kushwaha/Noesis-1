      }
    },
    {
      "text": "θ = ½αt² (from rest), in radians."
    },
    {
      "text": "Revolutions = θ ÷ 2π."
    }
  ],
  "feedback": {
    "rad-for-revolutions": {
      "text": "That angle is in radians. Divide by 2π for revolutions."
