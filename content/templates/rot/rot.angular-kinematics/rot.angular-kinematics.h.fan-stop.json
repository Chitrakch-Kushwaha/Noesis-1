  "stem": [
    "A fan spinning at {{w0}} rad/s is switched off and slows uniformly, making {{n}} revolutions before it stops.",
    "What is the size of its angular deceleration?"
  ],
  "input": {
    "label": "Angular deceleration",
    "placeholder": "for example 1.6 rad/s^2",
    "keypad": "none"
  },
  "answerText": "{{ans}} rad/s^2",
  "hints": [
    {
      "text": "Which rotational equation links ω, ω₀, α and θ?",
      "cue": {
        "cue": "play"
      }
    },
    {
      "text": "ω² = ω₀² − 2αθ with ω = 0."
    },
    {
      "text": "θ in radians: {{n}} rev × 2π."
    }
  ],
  "feedback": {
    "revs-not-converted": {
      "text": "In ω² = ω₀² + 2αθ, θ must be in radians: {{n}} rev = 2π × {{n}} rad."
    },
    "rot-missing-half": {
      "text": "0 = ω₀² − 2αθ gives α = ω₀² ÷ (2θ)."
    },
    "dimension-mismatch": {
      "text": "Check the unit: the answer is a angular acceleration."
    },
    "generic": {
      "text": "α = ω₀² ÷ (2θ), θ in radians."
    }
  },
  "workedSolution": [
    {
      "text": "θ = 2π × {{n}} = {{theta}} rad."
    },
    {
      "text": "α = {{w0}}² ÷ (2 × {{theta}}) = {{ans}} rad/s².",
      "cue": {
        "cue": "reveal"
      }
    }
  ],
  "flashcards": {
    "revs-not-converted": {
      "front": "Units of θ in ω² = ω₀² + 2αθ?",
