  "stem": [
    "A uniform rod of mass {{M}} kg and length {{L}} m rotates about a perpendicular axis through its centre (I = ML²/12).",
    "What is its radius of gyration?"
  ],
  "input": {
    "label": "Radius of gyration",
    "placeholder": "for example 0.35 m",
    "keypad": "none"
  },
  "answerText": "{{ans}} m",
  "hints": [
    {
      "text": "Radius of gyration k satisfies I = Mk².",
      "cue": {
        "cue": "highlight",
