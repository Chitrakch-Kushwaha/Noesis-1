  "stem": [
    "A light rod {{L}} m long carries {{m1}} kg at end A and {{m2}} kg at end B. It rotates about a perpendicular axis {{a}} m from A.",
    "What is its moment of inertia about this axis?"
  ],
  "input": {
    "label": "Moment of inertia",
    "placeholder": "for example 1.5 kg m^2",
    "keypad": "none"
  },
  "answerText": "{{ans}} kg m^2",
  "hints": [
    {
      "text": "Find each mass's distance from the axis.",
      "cue": {
        "cue": "highlight",
        "args": {
          "ids": [
            "a",
            "b",
            "ax"
          ]
        }
      }
    },
    {
      "text": "Measure each distance from the axis, not from end A."
    },
    {
      "text": "I = m₁r₁² + m₂r₂²."
    }
  ],
  "feedback": {
    "inertia-not-squared": {
      "text": "Each mass contributes m r², not m r."
    },
    "inertia-com-distance": {
      "text": "I depends on each mass's own distance from the axis: Σ m r²."
    },
    "dimension-mismatch": {
      "text": "Check the unit: the answer is a moment of inertia."
    },
    "generic": {
      "text": "I = Σ m r²."
    }
  },
  "workedSolution": [
    {
      "text": "r_A = {{a}} m, r_B = {{b}} m."
    },
    {
      "text": "I = {{m1}} × {{a}}² + {{m2}} × {{b}}² = {{ans}} kg m².",
      "cue": {
        "cue": "highlight",
        "args": {
          "ids": [
            "a",
            "b"
          ]
        }
      }
    }
  ],
  "flashcards": {
    "inertia-not-squared": {
      "front": "Moment of inertia of point masses?",
      "back": "Σ m r²."
    },
    "inertia-com-distance": {
      "front": "Can you use the centre of mass for I?",
      "back": "No: I = Σ m r² depends on where each mass is."
    },
    "generic": {
      "front": "Moment of inertia of point masses?",
      "back": "Σ m r², each r from the axis."
    }
  },
