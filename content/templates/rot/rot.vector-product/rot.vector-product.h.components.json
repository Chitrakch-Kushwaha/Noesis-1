  },
  "workedSolution": [
    {
      "text": "a × b = {{a1}}×{{b2}} (î × ĵ) + {{a2}}×{{b1}} (ĵ × î)."
    },
    {
      "text": "c = {{a1}} × {{b2}} − {{a2}} × {{b1}} = {{ans}}.",
      "cue": {
        "cue": "note",
        "args": {
          "text": "c = a₁b₂ − a₂b₁"
        }
      }
    }
  ],
