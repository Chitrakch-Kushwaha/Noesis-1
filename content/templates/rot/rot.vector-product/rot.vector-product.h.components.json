  "feedback": {
    "cross-as-dot": {
      "text": "That is a · b. For the cross product's z-component use a₁b₂ − a₂b₁."
    },
    "cross-order": {
      "text": "You computed b × a. Keep the order: c = a₁b₂ − a₂b₁."
    },
    "generic": {
      "text": "(a₁î + a₂ĵ) × (b₁î + b₂ĵ) = (a₁b₂ − a₂b₁) k̂."
