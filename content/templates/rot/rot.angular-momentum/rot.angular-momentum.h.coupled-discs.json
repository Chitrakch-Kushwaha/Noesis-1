  "stem": [
    "A {{M1}} kg disc of radius {{R}} m spins at {{w1}} rad/s. An identical-radius {{M2}} kg disc, not spinning, is dropped onto it on the same axis and they turn together.",
    "What is their common angular speed?"
  ],
  "input": {
    "label": "Angular speed",
    "placeholder": "for example 6 rad/s",
    "keypad": "none"
  },
  "answerText": "{{ans}} rad/s",
  "hints": [
    {
      "text": "Friction between the discs is internal: no external torque.",
      "cue": {
        "cue": "play"
      }
    },
    {
      "text": "I₁ω₁ = (I₁ + I₂)ω."
    },
    {
      "text": "Both are discs of the same radius: I = ½MR²."
    }
  ],
  "feedback": {
    "averages-angular-velocities": {
      "text": "Conserve angular momentum: I₁ω₁ = (I₁ + I₂)ω, which depends on the masses."
    },
    "rot-ke-conserved": {
      "text": "Kinetic energy isn't conserved when the discs grip each other; angular momentum is."
    },
    "dimension-mismatch": {
      "text": "Check the unit: the answer is a angular velocity."
    },
    "generic": {
      "text": "ω = I₁ω₁ ÷ (I₁ + I₂)."
    }
  },
  "workedSolution": [
    {
      "text": "I₁ = {{I1}} kg m², I₂ = {{I2}} kg m²."
    },
    {
      "text": "ω = {{I1}} × {{w1}} ÷ ({{I1}} + {{I2}}) = {{ans}} rad/s.",
      "cue": {
        "cue": "set-rotor",
        "args": {
          "key": "omega0",
          "value": "{{ans}}"
        }
      }
    }
  ],
