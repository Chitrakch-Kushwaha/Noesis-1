  "stem": [
    "A skater spins at {{w1}} rad/s with her arms out (I = {{I1}} kg m²). She pulls her arms in, reducing I to {{I2}} kg m².",
    "What is her new angular speed?"
  ],
  "input": {
    "label": "Angular speed",
    "placeholder": "for example 9 rad/s",
    "keypad": "none"
  },
  "answerText": "{{ans}} rad/s",
  "hints": [
    {
      "text": "No external torque acts about her axis.",
      "cue": {
        "cue": "play"
      }
    },
    {
      "text": "So I₁ω₁ = I₂ω₂."
    },
    {
      "text": "Solve for ω₂."
    }
  ],
  "feedback": {
    "am-ratio-inverted": {
      "text": "With less I, she must spin faster to keep L = Iω the same."
    },
    "dimension-mismatch": {
      "text": "Check the unit: the answer is a angular velocity."
    },
    "generic": {
      "text": "I₁ω₁ = I₂ω₂."
    }
  },
  "workedSolution": [
    {
      "text": "Angular momentum conserved: {{I1}} × {{w1}} = {{I2}} × ω₂."
    },
    {
      "text": "ω₂ = {{ans}} rad/s.",
      "cue": {
        "cue": "set-rotor",
        "args": {
          "key": "omega0",
          "value": "{{ans}}"
        }
      }
    }
  ],
  "flashcards": {
