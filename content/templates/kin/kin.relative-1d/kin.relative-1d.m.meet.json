  },
  "stem": [
    "Two cars start {{d}} m apart and drive towards each other at {{vA}} m/s and {{vB}} m/s.",
    "After how long do they meet?"
  ],
  "input": {
    "label": "Time",
    "placeholder": "for example 12 s",
    "keypad": "none"
  },
  "answerText": "{{ans}} s",
  "hints": [
    {
      "text": "How fast does the gap between them shrink?",
      "cue": {
        "cue": "play"
      }
    },
    {
      "text": "Approaching each other: closing speed = v_A + v_B."
    },
    {
      "text": "Time = gap ÷ closing speed."
    }
  ],
  "feedback": {
    "relative-subtracted-opposite": {
      "text": "They move towards each other, so the gap closes at the sum of their speeds.",
      "cue": {
        "cue": "play"
      }
    },
    "dimension-mismatch": {
      "text": "Check the unit: the answer is a time."
    },
    "generic": {
      "text": "Time to meet = initial gap ÷ (v_A + v_B)."
    }
  },
  "workedSolution": [
    {
      "text": "Closing speed: {{vA}} + {{vB}} = {{closing}} m/s."
    },
    {
      "text": "t = {{d}} ÷ {{closing}} = {{ans}} s.",
      "cue": {
        "cue": "flag",
        "args": {
          "x": "{{xMeet}}",
          "label": "meet"
        }
      }
    }
  ],
