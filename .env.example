# NOESIS server environment. Copy this file to .env.local and fill in what you need. .env.local is
# ignored by git: never commit a key, never put one in a NEXT_PUBLIC_ variable, never paste it in chat.
# See docs/09-ai-and-voice.md.

# --- Local AI preview (npm run dev only) ------------------------------------------------------------
# On your own computer, a key below is enough: `npm run dev` then turns on the AI tutor chat. If both
# keys are set, OpenAI is used unless STUDENT_AI_PROVIDER says otherwise. Production builds
# (npm run build / npm start / any deployment) ignore this and need every activation gate below.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional: openai or gemini (picks one when both keys are set)
STUDENT_AI_PROVIDER=
# Optional: set to false to keep the AI off even with a key; set STUDENT_AI_VOICE=false to hide voice
STUDENT_AI_ENABLED=
STUDENT_AI_VOICE=

# --- Optional model overrides (defaults are in adapters/openai and adapters/gemini) -----------------
OPENAI_TUTOR_MODEL=
OPENAI_TRANSCRIBE_MODEL=
OPENAI_SPEECH_MODEL=
OPENAI_SPEECH_VOICE=
OPENAI_TUTOR_MAX_OUTPUT_TOKENS=
GEMINI_TUTOR_MODEL=
GEMINI_TUTOR_MAX_OUTPUT_TOKENS=

# --- Production activation (a deployment; all required) ----------------------------------------------
# 1. config/student-ai.json records provider, providerDecision and privacyReview, and "text": true
# 2. npm run tutor:select-adapter -- --provider openai   (or gemini)
# 3. STUDENT_AI_ENABLED=true and STUDENT_AI_PROVIDER=<the recorded provider> in the server environment
# 4. the provider's key in the server environment
# Voice also needs "voice": true in the record and STUDENT_AI_VOICE=true.

# --- Developer fixture (development only; labelled canned replies and a test tone) ------------------
NOESIS_TUTOR_FIXTURES=
